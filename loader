local Junkie = loadstring(game:HttpGet("https://jnkie.com/sdk/library.lua"))()

Junkie.service = "Carbon Hub"
Junkie.identifier = "1160433"
Junkie.provider = "Fetchrawmetatable"

local function getKey()

    local link = Junkie.get_key_link()

    if link then
        if setclipboard then
            setclipboard(link)
        end
        print("Key link copied!")
    else
        warn("Please wait before requesting another key.")
        return nil
    end

    local key = getUserInput()

    if not key or key == "" then
        return nil
    end

    local result = Junkie.check_key(key)

    if result.valid then
        return key
    else
        warn("Invalid key: " .. (result.message or "Unknown error"))
        return nil
    end
end

local SCRIPT_KEY = getKey()

if not SCRIPT_KEY then
    warn("Key validation failed.")
    return
end

getgenv().SCRIPT_KEY = SCRIPT_KEY

